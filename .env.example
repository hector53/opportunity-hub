# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_USER=hub
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=opportunity_hub
DB_HOST_PORT=5434
APP_HOST_PORT=3100
# Used by host-side scripts (npm run db:migrate / db:seed / dev). The container builds its own.
DATABASE_URL=postgres://hub:change-me-long-random@127.0.0.1:5434/opportunity_hub

# --- Auth (single user) ---
# 32+ random chars: openssl rand -base64 48
AUTH_SECRET=
# Preferred: scrypt hash from `npm run auth:hash -- 'your password'` (format scrypt:salt:hash)
APP_PASSWORD_HASH=
# Alternative (10+ chars). Ignored if APP_PASSWORD_HASH is set.
APP_PASSWORD=
# true only when served over HTTPS (behind a TLS proxy). Keep false for SSH tunnel on http://localhost.
COOKIE_SECURE=false
# Local development only. Ignored (and startup fails) when NODE_ENV=production.
AUTH_DISABLED=false

# --- Private profile (optional) ---
# JSON with {profile, preferences}; loaded only by the first `db:seed`. Default path is git-ignored.
# PROFILE_FILE=config/profile.local.json

# --- Scheduler ---
SCHEDULER_ENABLED=true

# --- AI (optional) ---
# Server-side only. Without it, proposals fall back to clearly-labelled templates.
OPENROUTER_API_KEY=

# --- Future integrations (M1) — leave empty ---
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
